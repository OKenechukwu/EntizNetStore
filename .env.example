# EntizNetStore environment template
# Copy to .env.local for local development. Never commit real secrets.

# -----------------------------------------------------------------------------
# Supabase — browser-safe public configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# -----------------------------------------------------------------------------
# Supabase — server-only privileged configuration
# -----------------------------------------------------------------------------
# May be the same URL as NEXT_PUBLIC_SUPABASE_URL, but remains a server setting
# so privileged modules never need to depend on a browser-prefixed variable.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Never expose this value through NEXT_PUBLIC_* or client-side code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# -----------------------------------------------------------------------------
# Checkout quote providers
# -----------------------------------------------------------------------------
# M3 fails closed instead of fabricating shipping or tax. A cart that requires
# shipping/tax remains blocked while the relevant provider is unconfigured.
# Digital/non-taxable carts can still produce an internal zero-shipping/zero-tax
# quote without enabling money movement.
SHIPPING_QUOTE_PROVIDER=unconfigured
TAX_QUOTE_PROVIDER=unconfigured

# -----------------------------------------------------------------------------
# Buyer payments
# -----------------------------------------------------------------------------
# Processor selection is deliberately deferred until EntizNetStore has an
# approved legal entity/provider relationship. The application must remain
# safe with the default value below: checkout displays a pending-provider state
# and no external payment request is attempted.
PAYMENT_PROVIDER=unconfigured
NEXT_PUBLIC_PAYMENT_PROVIDER=unconfigured

# -----------------------------------------------------------------------------
# Seller payouts
# -----------------------------------------------------------------------------
# Payouts have an independent adapter boundary. `unconfigured` fails closed and
# never transfers or releases seller escrow.
PAYOUT_PROVIDER=unconfigured

# Required only when a real payout adapter is enabled. This is the business hold
# period after delivery before escrow can be claimed by a payout request. There
# is deliberately no default so production cannot accidentally adopt a policy.
# PAYOUT_HOLD_DAYS=7

# Add provider-specific server secrets only when an approved adapter is added.
# Examples will be documented with that adapter. Never expose provider secret
# keys, payout credentials, or webhook-signing secrets through NEXT_PUBLIC_*.

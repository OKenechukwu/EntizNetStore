# EntizNetStore environment template
# Copy to .env.local for local development. Never commit real secrets.

# -----------------------------------------------------------------------------
# Public launch controls
# -----------------------------------------------------------------------------
# Keep false for local/preview/staging. Set true only on the public production
# environment when the marketplace is intentionally ready for search indexing.
SITE_INDEXING_ENABLED=false

# -----------------------------------------------------------------------------
# Supabase — browser-safe public configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# -----------------------------------------------------------------------------
# Supabase — server-only privileged configuration
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# -----------------------------------------------------------------------------
# EntizNet → EntizNetStore secure identity handoff
# -----------------------------------------------------------------------------
# EntizNet signs 90-second Ed25519 assertions with its PRIVATE key. Store holds
# only the PUBLIC key, so a compromised Store deployment cannot mint EntizNet
# capability assertions. Generate/rotate these outside source control.
ENTIZNET_HANDOFF_ISSUER=entiznet
ENTIZNET_HANDOFF_AUDIENCE=entiznetstore
ENTIZNET_HANDOFF_KEY_ID=v1
# Base64-encoded DER SubjectPublicKeyInfo (SPKI), Ed25519. Public material only,
# but keep it server-side because browser code never needs integration keys.
ENTIZNET_HANDOFF_PUBLIC_KEY=BASE64_ED25519_SPKI_PUBLIC_KEY

# -----------------------------------------------------------------------------
# Checkout quote providers
# -----------------------------------------------------------------------------
SHIPPING_QUOTE_PROVIDER=unconfigured
TAX_QUOTE_PROVIDER=unconfigured

# -----------------------------------------------------------------------------
# Buyer payments
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=unconfigured
NEXT_PUBLIC_PAYMENT_PROVIDER=unconfigured

# -----------------------------------------------------------------------------
# Seller payouts
# -----------------------------------------------------------------------------
PAYOUT_PROVIDER=unconfigured
# Required only when a real payout adapter is enabled. Deliberately no default.
# PAYOUT_HOLD_DAYS=7

# Add provider-specific server secrets only when an approved adapter is added.
# Never expose service-role keys, payment/payout credentials, webhook secrets, or
# EntizNet private signing material through NEXT_PUBLIC_*.

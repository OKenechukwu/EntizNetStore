# EntizNetStore environment template
# Copy to .env.local for local development. Never commit real secrets.

# -----------------------------------------------------------------------------
# Supabase — browser-safe public configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# -----------------------------------------------------------------------------
# Supabase — server-only privileged configuration
# -----------------------------------------------------------------------------
# May be the same URL as NEXT_PUBLIC_SUPABASE_URL, but remains a server setting
# so privileged modules never need to depend on a browser-prefixed variable.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Never expose this value through NEXT_PUBLIC_* or client-side code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# Browser-safe publishable key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Server-only secret key used to create payment intents.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Server-only signing secret for /api/payments/webhook.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

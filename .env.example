# EntizNetStore environment template
# Copy to .env.local for local development. Never commit real secrets.

# -----------------------------------------------------------------------------
# Public launch controls
# -----------------------------------------------------------------------------
# Indexing is fail-closed and requires all three conditions:
# 1) VERCEL_ENV=production (provided by Vercel production runtime),
# 2) SITE_INDEXING_ENABLED=true,
# 3) PUBLIC_LAUNCH_CONFIRMATION=ENTIZNETSTORE_PUBLIC_WEB_V1.
# Keep these defaults everywhere until the intentional public-launch review.
SITE_INDEXING_ENABLED=false
PUBLIC_LAUNCH_CONFIRMATION=NOT_CONFIRMED

# -----------------------------------------------------------------------------
# Supabase — browser-safe public configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Preferred current credential for browser/SSR clients.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Legacy rollout fallback only. Remove after every environment has migrated.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_LEGACY_SUPABASE_ANON_KEY

# -----------------------------------------------------------------------------
# Supabase — server-only privileged configuration
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Preferred current backend-only credential. NEVER expose through NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Legacy rollout fallback only. Remove after every trusted runtime has migrated.
SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SUPABASE_SERVICE_ROLE_KEY

# -----------------------------------------------------------------------------
# Store Chat encryption — server only
# -----------------------------------------------------------------------------
# Preferred dedicated key-encryption material for wrapping each conversation's
# random AES-256-GCM data key. Use high-entropy secret material generated and
# stored outside source control. Never expose any MESSAGE_KEY_* value to clients.
MESSAGE_KEY_ENCRYPTION_KEY=YOUR_HIGH_ENTROPY_MESSAGE_KEK
MESSAGE_KEY_ENCRYPTION_KEY_ID=message-kek-v1
# During rotation, install the new primary above and keep the immediately
# previous key available until every existing envelope has been rewrapped.
# MESSAGE_KEY_ENCRYPTION_KEY_PREVIOUS=YOUR_PREVIOUS_MESSAGE_KEK
# MESSAGE_KEY_ENCRYPTION_KEY_PREVIOUS_ID=message-kek-v0
# Controlled rollout fallback: when no dedicated message KEK is configured, the
# server can derive a wrapping key from SUPABASE_SECRET_KEY and then the legacy
# service-role key. This prevents a hard cutover from stranding envelopes, but a
# dedicated MESSAGE_KEY_ENCRYPTION_KEY is required before public chat launch.
# IMPORTANT: do not remove/revoke the credential that wrapped an existing
# envelope until that envelope has been rewrapped under the new primary key.
# Changing MESSAGE_KEY_ENCRYPTION_KEY_ID without retaining the corresponding old
# key as *_PREVIOUS is intentionally fail-closed and can make messages unreadable.

# -----------------------------------------------------------------------------
# Upload quarantine / malware scanning — server only
# -----------------------------------------------------------------------------
# Production must use remote mode. The deterministic mode exists only for
# local/CI regression and is rejected in production outside CI.
UPLOAD_SCANNER_MODE=remote
UPLOAD_SCANNER_URL=https://YOUR_PRIVATE_SCANNER.example.com/scan
# Mandatory in production. Exact HTTPS origins only, comma-separated when a
# provider legitimately uses more than one origin. Do not include paths/query.
UPLOAD_SCANNER_ALLOWED_ORIGINS=https://YOUR_PRIVATE_SCANNER.example.com
UPLOAD_SCANNER_TOKEN=YOUR_SCANNER_BEARER_TOKEN
# Optional; bounded by the application to 1s..30s. Default is 12000ms.
UPLOAD_SCANNER_TIMEOUT_MS=12000

# -----------------------------------------------------------------------------
# EntizNet → EntizNetStore secure identity handoff
# -----------------------------------------------------------------------------
# EntizNet signs 90-second Ed25519 assertions with its PRIVATE key. Store holds
# only the PUBLIC key, so a compromised Store deployment cannot mint EntizNet
# capability assertions. Generate/rotate these outside source control.
ENTIZNET_HANDOFF_ISSUER=entiznet
ENTIZNET_HANDOFF_AUDIENCE=entiznetstore
ENTIZNET_HANDOFF_KEY_ID=v1
# Base64-encoded DER SubjectPublicKeyInfo (SPKI), Ed25519. Public material only,
# but keep it server-side because browser code never needs integration keys.
ENTIZNET_HANDOFF_PUBLIC_KEY=BASE64_ED25519_SPKI_PUBLIC_KEY

# -----------------------------------------------------------------------------
# Checkout quote providers
# -----------------------------------------------------------------------------
SHIPPING_QUOTE_PROVIDER=unconfigured
TAX_QUOTE_PROVIDER=unconfigured

# -----------------------------------------------------------------------------
# Buyer payments
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=unconfigured
NEXT_PUBLIC_PAYMENT_PROVIDER=unconfigured

# -----------------------------------------------------------------------------
# Seller payouts
# -----------------------------------------------------------------------------
PAYOUT_PROVIDER=unconfigured
# Required only when a real payout adapter is enabled. Deliberately no default.
# PAYOUT_HOLD_DAYS=7

# Add provider-specific server secrets only when an approved adapter is added.
# Never expose Supabase secret/service-role keys, message key-encryption material,
# payment/payout credentials, upload-scanner credentials, webhook secrets, or
# EntizNet private signing material through NEXT_PUBLIC_*.
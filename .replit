entrypoint = "package.json"
run = "bash -lc 'npm ci || npm i; HOST=0.0.0.0 PORT=${PORT:-3000} npm run dev'"
modules = ["nodejs-20", "postgresql-16"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true
integrations = ["javascript_supabase:1.0.0", "javascript_object_storage:1.0.0", "javascript_stripe:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
author = "agent"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -lc 'HOST=0.0.0.0 PORT=${PORT:-3000} npm run dev'"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Next.js App"

[[workflows.workflow]]
name = "Next.js App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 40511
externalPort = 3000

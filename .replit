entrypoint = "package.json"
run = "bash -lc 'npm ci || npm i; HOST=0.0.0.0 PORT=${PORT:-3000} npm run dev'"

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
author = "agent"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -lc 'HOST=0.0.0.0 PORT=${PORT:-3000} npm run dev'"

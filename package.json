{
  "name": "entiznetstore",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "PORT=${PORT:-3000} next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "verify:foundation": "node scripts/verify-production-foundation.mjs",
    "test:storage-recovery": "node --experimental-strip-types --test tests/storage-compensation.test.mts",
    "test:operational-logging": "node --experimental-strip-types --test tests/operational-event.test.mts",
    "test:production-http-smoke": "node scripts/test-production-http-smoke.mjs",
    "start": "PORT=${PORT:-3000} next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^4.0.2",
    "@stripe/stripe-js": "^7.9.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "framer-motion": "^12.23.21",
    "lucide-react": "^0.545.0",
    "next": "^16.3.1",
    "next-intl": "^4.3.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-select": "^5.10.2",
    "stripe": "^18.5.0",
    "uuid": "^12.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.1",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.0.0"
  }
}
